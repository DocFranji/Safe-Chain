# Copia este archivo a `.env` solo si necesitas cambiar algo. Todo es opcional:
# los valores por defecto están en src/config.ts.
# Las direcciones de los contratos están en scripts/.contratos (las imprime scripts/desplegar_testnet.sh).

# VITE_TANDA_ID=C...
# VITE_TOKEN_ID=C...

# VITE_RPC_URL=https://soroban-testnet.stellar.org
# VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Entrar con Google (Privy): el App ID de dashboard.privy.io. Vacío = solo Freighter.
# VITE_PRIVY_APP_ID=

# Faucet de TUSD de prueba. Por defecto: /api/faucet (api/faucet.ts). Vacío = sin botón.
# VITE_FAUCET_URL=

# Nombres para mostrar en lugar de direcciones (JSON). Lo escribe solo scripts/desplegar_testnet.sh.
# VITE_NOMBRES='{"G...":"Ana","G...":"Beto","G...":"Carla"}'

# Ponla en false cuando la bóveda deje de ser la simulada (por ejemplo, un adaptador a Blend).
# VITE_BOVEDA_SIMULADA=false

# ATENCIÓN: nunca pongas aquí la llave secreta del faucet (FAUCET_ISSUER_SECRET).
# Va solo en las variables de entorno del hosting (Vercel) o en web/.env.local, que no se sube.
